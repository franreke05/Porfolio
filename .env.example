# --- Email (Resend): owner notification for every lead -----------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=franciscorequenasanchez0@gmail.com
# onboarding@resend.dev only delivers to the Resend account owner. That is
# enough for owner notifications; use a verified domain for anything else.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Site ---------------------------------------------------------------------
# Public origin (scheme + host, no trailing slash). Used for the Origin
# allowlist and for the cancel link placed in calendar invitations.
SITE_ORIGIN=https://francisco-requena.vercel.app

# --- Signing ------------------------------------------------------------------
# >= 32 chars, random, different per environment. Signs form tokens and
# cancellation tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_SIGNING_SECRET=

# --- Calendar / video (Google Calendar + Meet) --------------------------------
# Leave CALENDAR_PROVIDER empty in production: Google is used when the three
# GOOGLE_OAUTH_* values exist. Get the refresh token with: node scripts/google-auth.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- LOCAL DEVELOPMENT ONLY (ignored / refused in production) -----------------
# memory = fake in-process calendar, no real event, invitation or video room.
# CALENDAR_PROVIDER=memory
# Comma-separated ISO instants (one slot each) and/or YYYY-MM-DD (whole day)
# reported as busy by the memory calendar, to demo busy slots and full days.
# BOOKING_DEV_BUSY=2026-10-08T09:00:00.000Z,2026-10-09
# Multiplies every rate limit locally so repeated manual testing is not blocked.
# RATE_LIMIT_DEV_MULTIPLIER=20
